# Written by scripts/spell_import/extract_spells.py when the ledger is
# incomplete. It is a worksheet, not a record — copy decisions into
# resolutions.json by hand.
scripts/spell_import/resolutions.proposed.json

.worktrees/

# Generated by tool/setup_web.dart (sqflite_common_ffi_web's shared-worker
# JS bundle and its version-matched sqlite3 WASM binary). Regenerate with
# `dart run tool/setup_web.dart` rather than committing these.
/web/sqflite_sw.js
/web/sqlite3.wasm
